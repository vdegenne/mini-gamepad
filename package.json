{
	"name": "@vdegenne/mini-gamepad",
	"version": "0.4.17",
	"type": "module",
	"devDependencies": {
		"@material/mwc-snackbar": "^0.27.0",
		"@snar/lit": "^1.8.1",
		"@vdegenne/debouncer": "^1.0.17",
		"inspector-elements": "^0.1.0",
		"lit": "^3.3.3",
		"material-shell": "^1.3.10",
		"rollup-plugin-material-all": "^1.2.2",
		"typescript": "^7.0.2",
		"vite": "^8.2.0",
		"wireit": "^0.14.13"
	},
	"dependencies": {
		"html-vision": "^0.3.10"
	},
	"exports": {
		".": {
			"default": "./lib/index.js",
			"types": "./lib/index.d.ts"
		},
		"./debug": {
			"default": "./lib/debug.js",
			"types": "./lib/debug.d.ts"
		},
		"./repeater.js": {
			"import": "./lib/repeater.js",
			"types": "./lib/repeater.d.ts"
		}
	},
	"files": [
		"./lib/"
	],
	"scripts": {
		"dev": "vite --open ./test/index.html",
		"build": "wireit"
	},
	"wireit": {
		"build": {
			"command": "tsc --pretty",
			"clean": "if-file-deleted",
			"files": [
				"./tsconfig.json",
				"./src"
			],
			"output": [
				"./lib"
			]
		}
	}
}
