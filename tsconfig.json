{
	"compilerOptions": {
		"target": "esnext",
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"strict": false,
		"useDefineForClassFields": false,
		"experimentalDecorators": true,
		"outDir": "./lib/",
		"rootDir": "./src/",
		"declaration": true,
		"declarationMap": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"types": ["vite/client"]
	},
	"include": ["./src/**/*.ts"],
	"exclude": []
}
